# Banco de dados (SQLite para desenvolvimento; ver README para PostgreSQL em produção)
DATABASE_URL="file:./dev.db"

# URL pública da aplicação (usada para montar links de redefinição de senha)
APP_URL="http://localhost:3000"

# Fuso horário da clínica (datas de consulta são digitadas neste fuso)
APP_TIMEZONE="America/Sao_Paulo"

# Provisionamento da conta administrativa (usado apenas por `npm run admin:create`).
# Remova estes valores do ambiente depois de criar a conta.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Identificação da controladora dos dados exibida na Política de Privacidade
PRIVACY_CONTROLLER_NAME="Profissional responsável pela Flor de Lótus"
PRIVACY_CONTACT="contato@flordelotus.exemplo"
